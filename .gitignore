# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# one-time Places import artifacts (do not commit API payloads)
src/data/staging/*.json
src/data/staging/*.staging.json
*.staging.json
.import-cache/
db/import-generated.sql

# vercel
.vercel

# cloudflare / opennext
.open-next/
.wrangler/

# typescript
*.tsbuildinfo
next-env.d.ts

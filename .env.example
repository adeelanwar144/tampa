# Local only. Never committed. Never read by the deployed app.
GOOGLE_PLACES_API_KEY=

# Optional — used by the one-time import to upload photos to R2 via the S3 API.
# If omitted, the script tries `wrangler r2 object put` and otherwise writes
# .import-cache/places/{place_id}/{n}.jpg for a later upload.
CLOUDFLARE_ACCOUNT_ID=2ab254ade8c5380dfd3c8e0f9c8cce4f
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tampa-bay-guide-images

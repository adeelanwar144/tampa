# Local only. Never committed. Never read by the deployed app for Places.
GOOGLE_PLACES_API_KEY=

# Article generator (scripts/article-gen)
Claude_API_KEY=
PEXELS_API_KEY=
CLAUDE_MODEL_SONNET=claude-sonnet-5-5
CLAUDE_MODEL_HAIKU=claude-haiku-5-5

# Optional — photo import and listing-content use the S3 API when these are set.
# R2_ACCOUNT_ID may be used instead of CLOUDFLARE_ACCOUNT_ID.
# If the access keys are omitted, scripts fall back to `wrangler r2 object put --remote`.
# Photos stay in tampa-bay-guide-images. Listing JSON goes to the private listing-content bucket.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tampa-bay-guide-images
